{
  "name": "chopinly",
  "private": true,
  "type": "module",
  "description": "Piano practice assistant PWA — no build step, no dependencies",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "deploy": "wrangler pages deploy . --project-name woodshed --branch main",
    "dev": "wrangler pages dev . --local --port 8788",
    "db:migrate": "wrangler d1 migrations apply chopinly --remote",
    "db:migrate:local": "wrangler d1 migrations apply chopinly --local"
  }
}
